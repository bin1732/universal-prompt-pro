{
  "meta": {
    "purpose": "PII 检测正则（黄线：脱敏后继续，提示用户）",
    "maintenance": "预置 + 可配置；黄线层可联网更新（自动 + 来源标注）",
    "version": "1.0.1"
  },
  "pii_patterns": [
    { "name": "cn_phone", "label": "中国大陆手机号", "regex": "(?<!\\d)1[3-9]\\d{9}(?!\\d)" },
    { "name": "cn_id", "label": "身份证号（18 位）", "regex": "(?<!\\d)[1-9]\\d{5}(?:19|20)\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx](?!\\d)" },
    { "name": "email", "label": "邮箱", "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}" },
    { "name": "ipv4", "label": "IPv4 地址", "regex": "(?<!\\d)(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}(?!\\d)" },
    { "name": "api_key_sk", "label": "sk- 风格密钥", "regex": "\\bsk-[A-Za-z0-9]{16,}\\b" },
    { "name": "bank_card", "label": "银行卡号（16-19 位）", "regex": "(?<!\\d)\\d{16,19}(?!\\d)" }
  ],
  "note": "命中 PII → 脱敏（替换为 [REDACTED]）后继续构建；输出同样脱敏；提示用户。词库仅用于检测与脱敏，不采集任何个人信息。"
}
